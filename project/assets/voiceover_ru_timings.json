[{"start": 0.0, "end": 3.74, "text": " Представь, что ты принимаешь десятки решений каждый день.", "words": [[0.0, 0.8, " Представь,"], [0.94, 1.14, " что"], [1.14, 1.3, " ты"], [1.3, 1.9, " принимаешь"], [1.9, 2.48, " десятки"], [2.48, 2.96, " решений"], [2.96, 3.26, " каждый"], [3.26, 3.74, " день."]]}, {"start": 4.2, "end": 7.38, "text": " Что надеть? Куда пойти? Кому доверять?", "words": [[4.2, 4.52, " Что"], [4.52, 4.92, " надеть?"], [5.44, 5.68, " Куда"], [5.68, 6.12, " пойти?"], [6.68, 6.94, " Кому"], [6.94, 7.38, " доверять?"]]}, {"start": 8.14, "end": 12.9, "text": " Но что, если многие из этих решений ты принимаешь, даже не задумываясь?", "words": [[8.14, 8.34, " Но"], [8.34, 8.52, " что,"], [8.6, 8.76, " если"], [8.76, 9.22, " многие"], [9.22, 9.48, " из"], [9.48, 9.66, " этих"], [9.66, 10.18, " решений"], [10.18, 10.66, " ты"], [10.66, 11.3, " принимаешь,"], [11.56, 11.92, " даже"], [11.92, 12.1, " не"], [12.1, 12.9, " задумываясь?"]]}, {"start": 13.44, "end": 17.24, "text": " Психолог Даниэль Каниман посвятил этому целую книгу.", "words": [[13.44, 14.06, " Психолог"], [14.06, 14.74, " Даниэль"], [14.74, 15.28, " Каниман"], [15.28, 16.08, " посвятил"], [16.08, 16.34, " этому"], [16.34, 16.78, " целую"], [16.78, 17.24, " книгу."]]}, {"start": 17.8, "end": 20.0, "text": " Думай медленно, решай быстро.", "words": [[17.8, 18.1, " Думай"], [18.1, 18.68, " медленно,"], [19.18, 19.58, " решай"], [19.58, 20.0, " быстро."]]}, {"start": 20.76, "end": 23.04, "text": " Он описывает два режима мышления.", "words": [[20.76, 20.94, " Он"], [20.94, 21.54, " описывает"], [21.54, 22.04, " два"], [22.04, 22.54, " режима"], [22.54, 23.04, " мышления."]]}, {"start": 23.8, "end": 25.74, "text": " Первый — быстрое мышление.", "words": [[23.8, 24.38, " Первый"], [24.38, 24.84, " —"], [24.84, 25.24, " быстрое"], [25.24, 25.74, " мышление."]]}, {"start": 26.32, "end": 27.9, "text": " Оно работает автоматически.", "words": [[26.32, 26.54, " Оно"], [26.54, 26.98, " работает"], [26.98, 27.9, " автоматически."]]}, {"start": 28.540000000000003, "end": 31.44, "text": " Ты видишь знакомое лицо и узнаешь человека.", "words": [[28.240000000000002, 28.68, " Ты"], [28.68, 28.98, " видишь"], [28.98, 29.58, " знакомое"], [29.58, 29.96, " лицо"], [29.96, 30.42, " и"], [30.42, 30.9, " узнаешь"], [30.9, 31.44, " человека."]]}, {"start": 32.0, "end": 35.02, "text": " Слышишь резкий звук и сразу обращаешь внимание.", "words": [[32.0, 32.52, " Слышишь"], [32.52, 33.02, " резкий"], [33.02, 33.42, " звук"], [33.42, 33.82, " и"], [33.82, 34.12, " сразу"], [34.12, 34.74, " обращаешь"], [34.74, 35.02, " внимание."]]}, {"start": 35.78, "end": 38.4, "text": " Тебе не нужно специально заставлять себя это делать.", "words": [[35.78, 36.02, " Тебе"], [36.02, 36.14, " не"], [36.14, 36.4, " нужно"], [36.4, 37.04, " специально"], [37.04, 37.64, " заставлять"], [37.64, 37.86, " себя"], [37.86, 38.12, " это"], [38.12, 38.4, " делать."]]}, {"start": 39.0, "end": 39.94, "text": " Но есть проблема.", "words": [[39.0, 39.26, " Но"], [39.26, 39.48, " есть"], [39.48, 39.94, " проблема."]]}, {"start": 40.66, "end": 44.22, "text": " Быстрае мышление иногда делает поспешные выводы.", "words": [[40.66, 41.24, " Быстрае"], [41.24, 41.68, " мышление"], [41.68, 42.42, " иногда"], [42.42, 43.02, " делает"], [43.02, 43.72, " поспешные"], [43.72, 44.22, " выводы."]]}, {"start": 44.84, "end": 48.6, "text": " Например, ты встречаешь человека, который выглядит уверенным", "words": [[44.84, 45.28, " Например,"], [45.48, 45.54, " ты"], [45.54, 46.1, " встречаешь"], [46.1, 46.6, " человека,"], [47.06, 47.36, " который"], [47.36, 47.88, " выглядит"], [47.88, 48.6, " уверенным"]]}, {"start": 48.6, "end": 53.0, "text": " и почти сразу решаешь, что он хорошо разбирается в своем деле.", "words": [[48.6, 49.14, " и"], [49.14, 49.46, " почти"], [49.46, 49.9, " сразу"], [49.9, 50.4, " решаешь,"], [50.68, 50.96, " что"], [50.96, 51.14, " он"], [51.14, 51.5, " хорошо"], [51.5, 52.2, " разбирается"], [52.2, 52.38, " в"], [52.38, 52.68, " своем"], [52.68, 53.0, " деле."]]}, {"start": 53.58, "end": 56.26, "text": " Хотя на самом деле ты этого еще не знаешь.", "words": [[53.58, 53.86, " Хотя"], [53.86, 54.06, " на"], [54.06, 54.28, " самом"], [54.28, 54.64, " деле"], [54.64, 55.14, " ты"], [55.14, 55.42, " этого"], [55.42, 55.64, " еще"], [55.64, 55.84, " не"], [55.84, 56.26, " знаешь."]]}, {"start": 57.14, "end": 61.38, "text": " И здесь появляется второй режим — медленное мышление.", "words": [[56.760000000000005, 57.24, " И"], [57.24, 57.6, " здесь"], [57.6, 58.26, " появляется"], [58.26, 59.0, " второй"], [59.0, 59.5, " режим"], [59.5, 60.06, " —"], [60.06, 60.8, " медленное"], [60.8, 61.38, " мышление."]]}, {"start": 62.2, "end": 64.36, "text": " Оно требует внимания и усилий.", "words": [[62.2, 62.48, " Оно"], [62.48, 62.9, " требует"], [62.9, 63.5, " внимания"], [63.5, 63.76, " и"], [63.76, 64.36, " усилий."]]}, {"start": 64.94, "end": 69.46, "text": " Ты анализируешь информацию, сравниваешь факты и задаешь себе вопросы.", "words": [[64.94, 65.08, " Ты"], [65.08, 65.74, " анализируешь"], [65.74, 66.5, " информацию,"], [66.92, 67.48, " сравниваешь"], [67.48, 68.0, " факты"], [68.0, 68.4, " и"], [68.4, 68.76, " задаешь"], [68.76, 69.06, " себе"], [69.06, 69.46, " вопросы."]]}, {"start": 70.36, "end": 74.14, "text": " Но мы не всегда используем его, потому что думать внимательно", "words": [[70.36, 70.6, " Но"], [70.6, 70.72, " мы"], [70.72, 70.86, " не"], [70.86, 71.22, " всегда"], [71.22, 71.88, " используем"], [71.88, 72.2, " его,"], [72.56, 72.82, " потому"], [72.82, 73.1, " что"], [73.1, 73.44, " думать"], [73.44, 74.14, " внимательно"]]}, {"start": 74.14, "end": 78.3, "text": " бывает сложнее, чем просто довериться первому впечатлению.", "words": [[74.14, 74.7, " бывает"], [74.7, 75.42, " сложнее,"], [75.46, 75.66, " чем"], [75.66, 76.08, " просто"], [76.08, 77.04, " довериться"], [77.04, 77.56, " первому"], [77.56, 78.3, " впечатлению."]]}, {"start": 79.0, "end": 80.1, "text": " И вот главный вопрос.", "words": [[79.0, 79.18, " И"], [79.18, 79.34, " вот"], [79.34, 79.82, " главный"], [79.82, 80.1, " вопрос."]]}, {"start": 80.88, "end": 84.14, "text": " Сколько твоих решений основано на реальных фактах?", "words": [[80.88, 81.24, " Сколько"], [81.24, 81.68, " твоих"], [81.68, 82.2, " решений"], [82.2, 83.0, " основано"], [83.0, 83.16, " на"], [83.16, 83.54, " реальных"], [83.54, 84.14, " фактах?"]]}, {"start": 84.14, "end": 86.56, "text": " А сколько на первом впечатлении?", "words": [[84.14, 84.56, " А"], [84.56, 84.9, " сколько"], [84.9, 85.46, " на"], [85.46, 85.88, " первом"], [85.88, 86.56, " впечатлении?"]]}, {"start": 87.3, "end": 92.5, "text": " В следующий раз, когда будешь уверен в своем отрете, остановись на секунду.", "words": [[87.3, 87.48, " В"], [87.48, 88.06, " следующий"], [88.06, 88.28, " раз,"], [88.66, 88.84, " когда"], [88.84, 89.28, " будешь"], [89.28, 89.84, " уверен"], [89.84, 89.96, " в"], [89.96, 90.24, " своем"], [90.24, 90.7, " отрете,"], [91.18, 91.78, " остановись"], [91.78, 91.92, " на"], [91.92, 92.5, " секунду."]]}, {"start": 93.08, "end": 95.68, "text": " Возможно, стоит подумать еще раз.", "words": [[93.08, 93.6, " Возможно,"], [94.06, 94.46, " стоит"], [94.46, 95.08, " подумать"], [95.08, 95.36, " еще"], [95.36, 95.68, " раз."]]}]