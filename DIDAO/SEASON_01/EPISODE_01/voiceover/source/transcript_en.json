[{"start": 0.0, "end": 3.32, "text": " Imagine going camping in the forest with your friends for the weekend.", "words": [[0.0, 0.46, " Imagine"], [0.46, 0.8, " going"], [0.8, 1.26, " camping"], [1.26, 1.46, " in"], [1.46, 1.56, " the"], [1.56, 1.88, " forest"], [1.88, 2.16, " with"], [2.16, 2.3, " your"], [2.3, 2.66, " friends"], [2.66, 2.88, " for"], [2.88, 2.96, " the"], [2.96, 3.32, " weekend."]]}, {"start": 3.88, "end": 8.0, "text": " You just want to relax, set up a tent, and spend a night under the stars.", "words": [[3.88, 4.0, " You"], [4.0, 4.18, " just"], [4.18, 4.36, " want"], [4.36, 4.46, " to"], [4.46, 4.84, " relax,"], [5.34, 5.46, " set"], [5.46, 5.58, " up"], [5.58, 5.7, " a"], [5.7, 5.92, " tent,"], [6.3, 6.46, " and"], [6.46, 6.72, " spend"], [6.72, 6.9, " a"], [6.9, 7.16, " night"], [7.16, 7.46, " under"], [7.46, 7.62, " the"], [7.62, 8.0, " stars."]]}, {"start": 8.6, "end": 12.96, "text": " But you have no idea that this forest is about to become your trap.", "words": [[8.6, 8.84, " But"], [8.84, 8.96, " you"], [8.96, 9.16, " have"], [9.16, 9.44, " no"], [9.44, 9.86, " idea"], [9.86, 10.46, " that"], [10.46, 10.72, " this"], [10.72, 11.12, " forest"], [11.12, 11.44, " is"], [11.44, 11.72, " about"], [11.72, 11.92, " to"], [11.92, 12.26, " become"], [12.26, 12.66, " your"], [12.66, 12.96, " trap."]]}, {"start": 13.46, "end": 15.98, "text": " On the first evening, everything seems normal.", "words": [[13.46, 13.64, " On"], [13.64, 13.76, " the"], [13.76, 13.94, " first"], [13.94, 14.34, " evening,"], [14.68, 14.92, " everything"], [14.92, 15.5, " seems"], [15.5, 15.98, " normal."]]}, {"start": 16.62, "end": 19.34, "text": " You're sitting around the campfire, talking and laughing.", "words": [[16.62, 16.8, " You're"], [16.8, 17.02, " sitting"], [17.02, 17.32, " around"], [17.32, 17.5, " the"], [17.5, 18.06, " campfire,"], [18.34, 18.64, " talking"], [18.64, 18.98, " and"], [18.98, 19.34, " laughing."]]}, {"start": 20.02, "end": 23.92, "text": " Suddenly, your friend notices a tall figure standing between the trees.", "words": [[20.02, 20.42, " Suddenly,"], [20.74, 20.86, " your"], [20.86, 21.16, " friend"], [21.16, 21.56, " notices"], [21.56, 21.94, " a"], [21.94, 22.24, " tall"], [22.24, 22.6, " figure"], [22.6, 23.06, " standing"], [23.06, 23.42, " between"], [23.42, 23.64, " the"], [23.64, 23.92, " trees."]]}, {"start": 24.54, "end": 27.4, "text": " It's so tall that it almost reaches the treetops.", "words": [[24.54, 24.88, " It's"], [24.88, 25.06, " so"], [25.06, 25.44, " tall"], [25.44, 25.86, " that"], [25.86, 25.94, " it"], [25.94, 26.28, " almost"], [26.28, 26.68, " reaches"], [26.68, 26.9, " the"], [26.9, 27.4, " treetops."]]}, {"start": 27.4, "end": 29.54, "text": " You point your flashlight toward it.", "words": [[27.4, 28.06, " You"], [28.06, 28.32, " point"], [28.32, 28.5, " your"], [28.5, 28.96, " flashlight"], [28.96, 29.34, " toward"], [29.34, 29.54, " it."]]}, {"start": 29.92, "end": 32.28, "text": " But the next second, the figure disappears.", "words": [[29.92, 30.12, " But"], [30.12, 30.24, " the"], [30.24, 30.44, " next"], [30.44, 30.84, " second,"], [31.16, 31.28, " the"], [31.28, 31.68, " figure"], [31.68, 32.28, " disappears."]]}, {"start": 33.3, "end": 36.22, "text": " You decide it was just a trick of the shadows and go to sleep.", "words": [[33.3, 33.42, " You"], [33.42, 33.76, " decide"], [33.76, 33.92, " it"], [33.92, 34.06, " was"], [34.06, 34.26, " just"], [34.26, 34.42, " a"], [34.42, 34.62, " trick"], [34.62, 34.76, " of"], [34.76, 34.88, " the"], [34.88, 35.2, " shadows"], [35.2, 35.66, " and"], [35.66, 35.8, " go"], [35.8, 35.92, " to"], [35.92, 36.22, " sleep."]]}, {"start": 36.76, "end": 39.9, "text": " Around midnight, you wake up because of a strange sound.", "words": [[36.76, 37.06, " Around"], [37.06, 37.44, " midnight,"], [37.8, 37.94, " you"], [37.94, 38.16, " wake"], [38.16, 38.4, " up"], [38.4, 38.68, " because"], [38.68, 38.86, " of"], [38.86, 38.96, " a"], [38.96, 39.36, " strange"], [39.36, 39.9, " sound."]]}, {"start": 40.48, "end": 41.82, "text": " Three slow footsteps.", "words": [[40.48, 40.8, " Three"], [40.8, 41.34, " slow"], [41.34, 41.82, " footsteps."]]}, {"start": 42.54, "end": 43.42, "text": " Then silence.", "words": [[42.54, 42.96, " Then"], [42.96, 43.42, " silence."]]}, {"start": 44.14, "end": 45.34, "text": " And three more footsteps.", "words": [[44.14, 44.38, " And"], [44.38, 44.66, " three"], [44.66, 44.92, " more"], [44.92, 45.34, " footsteps."]]}, {"start": 46.16, "end": 48.52, "text": " You carefully open the tent and look outside.", "words": [[46.16, 46.36, " You"], [46.36, 46.7, " carefully"], [46.7, 47.08, " open"], [47.08, 47.24, " the"], [47.24, 47.5, " tent"], [47.5, 47.86, " and"], [47.86, 48.06, " look"], [48.06, 48.52, " outside."]]}, {"start": 49.28, "end": 51.62, "text": " The same figure is standing in the clearing.", "words": [[49.28, 49.46, " The"], [49.46, 49.74, " same"], [49.74, 50.14, " figure"], [50.14, 50.5, " is"], [50.5, 50.96, " standing"], [50.96, 51.2, " in"], [51.2, 51.32, " the"], [51.32, 51.62, " clearing."]]}, {"start": 52.24, "end": 55.22, "text": " Tall, thin, wearing a black suit.", "words": [[52.24, 52.66, " Tall,"], [53.1, 53.48, " thin,"], [53.98, 54.3, " wearing"], [54.3, 54.58, " a"], [54.58, 54.82, " black"], [54.82, 55.22, " suit."]]}, {"start": 55.22, "end": 57.46, "text": " But there's something even stranger.", "words": [[55.22, 55.88, " But"], [55.88, 56.16, " there's"], [56.16, 56.42, " something"], [56.42, 56.82, " even"], [56.82, 57.46, " stranger."]]}, {"start": 58.08, "end": 59.18, "text": " It has no face.", "words": [[58.08, 58.24, " It"], [58.24, 58.48, " has"], [58.48, 58.78, " no"], [58.78, 59.18, " face."]]}, {"start": 59.9, "end": 61.26, "text": " You quickly wake your friends.", "words": [[59.9, 60.04, " You"], [60.04, 60.4, " quickly"], [60.4, 60.72, " wake"], [60.72, 60.92, " your"], [60.92, 61.26, " friends."]]}, {"start": 61.76, "end": 64.9, "text": " But when they rush outside, the figure is already gone.", "words": [[61.76, 61.94, " But"], [61.94, 62.08, " when"], [62.08, 62.2, " they"], [62.2, 62.5, " rush"], [62.5, 62.98, " outside,"], [63.38, 63.48, " the"], [63.48, 63.8, " figure"], [63.8, 64.14, " is"], [64.14, 64.6, " already"], [64.6, 64.9, " gone."]]}, {"start": 65.5, "end": 68.28, "text": " In the morning, you decide to leave the forest immediately.", "words": [[65.5, 65.64, " In"], [65.64, 65.74, " the"], [65.74, 66.02, " morning,"], [66.3, 66.4, " you"], [66.4, 66.76, " decide"], [66.76, 66.96, " to"], [66.96, 67.18, " leave"], [67.18, 67.38, " the"], [67.38, 67.82, " forest"], [67.82, 68.28, " immediately."]]}, {"start": 69.04, "end": 71.5, "text": " But the road you use to get here has disappeared.", "words": [[69.04, 69.24, " But"], [69.24, 69.38, " the"], [69.38, 69.62, " road"], [69.62, 69.82, " you"], [69.82, 70.1, " use"], [70.1, 70.26, " to"], [70.26, 70.44, " get"], [70.44, 70.74, " here"], [70.74, 71.06, " has"], [71.06, 71.5, " disappeared."]]}, {"start": 72.3, "end": 74.86, "text": " Everywhere you look, there are identical trees.", "words": [[72.3, 72.72, " Everywhere"], [72.72, 73.04, " you"], [73.04, 73.32, " look,"], [73.56, 73.64, " there"], [73.64, 73.82, " are"], [73.82, 74.38, " identical"], [74.38, 74.86, " trees."]]}, {"start": 75.54, "end": 80.44, "text": " You start searching for an exit until you notice a strange message carved into a tree.", "words": [[75.54, 75.72, " You"], [75.72, 75.98, " start"], [75.98, 76.36, " searching"], [76.36, 76.64, " for"], [76.64, 76.76, " an"], [76.76, 77.08, " exit"], [77.08, 77.56, " until"], [77.56, 77.74, " you"], [77.74, 77.98, " notice"], [77.98, 78.24, " a"], [78.24, 78.66, " strange"], [78.66, 79.22, " message"], [79.22, 79.66, " carved"], [79.66, 80.02, " into"], [80.02, 80.2, " a"], [80.2, 80.44, " tree."]]}, {"start": 81.16, "end": 82.4, "text": " Do not look back.", "words": [[81.16, 81.36, " Do"], [81.36, 81.7, " not"], [81.7, 82.04, " look"], [82.04, 82.4, " back."]]}, {"start": 82.96000000000001, "end": 85.3, "text": " At that moment, your phone vibrates.", "words": [[82.88, 83.16, " At"], [83.16, 83.42, " that"], [83.42, 83.74, " moment,"], [84.1, 84.26, " your"], [84.26, 84.62, " phone"], [84.62, 85.3, " vibrates."]]}, {"start": 85.92, "end": 88.22, "text": " A message appears from an unknown sender.", "words": [[85.92, 86.06, " A"], [86.06, 86.36, " message"], [86.36, 86.74, " appears"], [86.74, 87.1, " from"], [87.1, 87.22, " an"], [87.22, 87.66, " unknown"], [87.66, 88.22, " sender."]]}, {"start": 88.64, "end": 89.72, "text": " I can see you all.", "words": [[88.64, 88.8, " I"], [88.8, 88.98, " can"], [88.98, 89.26, " see"], [89.26, 89.46, " you"], [89.46, 89.72, " all."]]}, {"start": 90.32, "end": 92.56, "text": " You raise your head and look between the trees.", "words": [[90.32, 90.56, " You"], [90.56, 90.76, " raise"], [90.76, 90.96, " your"], [90.96, 91.22, " head"], [91.22, 91.54, " and"], [91.54, 91.74, " look"], [91.74, 92.04, " between"], [92.04, 92.26, " the"], [92.26, 92.56, " trees."]]}, {"start": 93.36, "end": 95.78, "text": " Three identical figures are standing there.", "words": [[93.36, 93.64, " Three"], [93.64, 94.14, " identical"], [94.14, 94.78, " figures"], [94.78, 95.06, " are"], [95.06, 95.46, " standing"], [95.46, 95.78, " there."]]}, {"start": 96.24, "end": 98.6, "text": " But one of them is much closer than the others.", "words": [[96.24, 96.48, " But"], [96.48, 96.7, " one"], [96.7, 96.82, " of"], [96.82, 97.0, " them"], [97.0, 97.28, " is"], [97.28, 97.56, " much"], [97.56, 98.0, " closer"], [98.0, 98.2, " than"], [98.2, 98.38, " the"], [98.38, 98.6, " others."]]}, {"start": 99.26, "end": 100.58, "text": " Suddenly, your friend whispers,", "words": [[99.26, 99.68, " Suddenly,"], [99.86, 99.94, " your"], [99.94, 100.24, " friend"], [100.24, 100.58, " whispers,"]]}, {"start": 101.24, "end": 103.12, "text": " Wait, where is the fourth one?", "words": [[101.24, 101.46, " Wait,"], [102.0, 102.26, " where"], [102.26, 102.42, " is"], [102.42, 102.54, " the"], [102.54, 102.82, " fourth"], [102.82, 103.12, " one?"]]}, {"start": 103.66, "end": 104.4, "text": " You turn around.", "words": [[103.66, 103.82, " You"], [103.82, 104.02, " turn"], [104.02, 104.4, " around."]]}, {"start": 104.82, "end": 106.46, "text": " But the tent is already empty.", "words": [[104.82, 104.98, " But"], [104.98, 105.1, " the"], [105.1, 105.36, " tent"], [105.36, 105.66, " is"], [105.66, 106.04, " already"], [106.04, 106.46, " empty."]]}, {"start": 107.06, "end": 108.62, "text": " Where do you think your friend disappeared?", "words": [[107.06, 107.26, " Where"], [107.26, 107.38, " do"], [107.38, 107.48, " you"], [107.48, 107.66, " think"], [107.66, 107.84, " your"], [107.84, 108.26, " friend"], [108.26, 108.62, " disappeared?"]]}]