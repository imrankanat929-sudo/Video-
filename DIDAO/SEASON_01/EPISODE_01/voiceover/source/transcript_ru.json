[{"start": 0.0, "end": 3.6, "text": " Представь, что ты отправился с друзьями в лес на выходные.", "words": [[0.0, 0.68, " Представь,"], [0.74, 0.94, " что"], [0.94, 1.12, " ты"], [1.12, 1.74, " отправился"], [1.74, 1.92, " с"], [1.92, 2.42, " друзьями"], [2.42, 2.52, " в"], [2.52, 2.7, " лес"], [2.7, 3.04, " на"], [3.04, 3.6, " выходные."]]}, {"start": 4.06, "end": 8.84, "text": " Вы хотели просто отдохнуть, разбить палатку и провести ночь под звездами.", "words": [[4.06, 4.28, " Вы"], [4.28, 4.62, " хотели"], [4.62, 5.06, " просто"], [5.06, 5.76, " отдохнуть,"], [6.02, 6.26, " разбить"], [6.26, 6.82, " палатку"], [6.82, 7.2, " и"], [7.2, 7.7, " провести"], [7.7, 8.12, " ночь"], [8.12, 8.3, " под"], [8.3, 8.84, " звездами."]]}, {"start": 9.22, "end": 13.76, "text": " Но вы даже не представляли, что этот лес станет вашей ловушкой.", "words": [[9.22, 9.46, " Но"], [9.46, 9.72, " вы"], [9.72, 10.1, " даже"], [10.1, 10.26, " не"], [10.26, 10.98, " представляли,"], [11.14, 11.32, " что"], [11.32, 11.72, " этот"], [11.72, 12.02, " лес"], [12.02, 12.76, " станет"], [12.76, 13.24, " вашей"], [13.24, 13.76, " ловушкой."]]}, {"start": 14.18, "end": 16.3, "text": " В первый вечер всё было спокойно.", "words": [[14.18, 14.3, " В"], [14.3, 14.54, " первый"], [14.54, 15.02, " вечер"], [15.02, 15.32, " всё"], [15.32, 15.64, " было"], [15.64, 16.3, " спокойно."]]}, {"start": 16.68, "end": 19.36, "text": " Вы сидели у костра, разговаривали и шутили.", "words": [[16.68, 16.84, " Вы"], [16.84, 17.1, " сидели"], [17.1, 17.26, " у"], [17.26, 17.62, " костра,"], [17.9, 18.64, " разговаривали"], [18.64, 18.92, " и"], [18.92, 19.36, " шутили."]]}, {"start": 19.8, "end": 24.06, "text": " Но вдруг твой друг заметил между деревьями высокую фигуру.", "words": [[19.8, 20.02, " Но"], [20.02, 20.36, " вдруг"], [20.36, 20.9, " твой"], [20.9, 21.12, " друг"], [21.12, 21.78, " заметил"], [21.78, 22.04, " между"], [22.04, 22.78, " деревьями"], [22.78, 23.52, " высокую"], [23.52, 24.06, " фигуру."]]}, {"start": 24.42, "end": 28.7, "text": " Она была настолько высокой, что почти доставала до верхушек деревьев.", "words": [[24.42, 24.64, " Она"], [24.64, 24.82, " была"], [24.82, 25.32, " настолько"], [25.32, 26.04, " высокой,"], [26.36, 26.52, " что"], [26.52, 26.9, " почти"], [26.9, 27.58, " доставала"], [27.58, 27.74, " до"], [27.74, 28.22, " верхушек"], [28.22, 28.7, " деревьев."]]}, {"start": 28.7, "end": 30.68, "text": " Ты направил на неё фонарик.", "words": [[28.7, 29.28, " Ты"], [29.28, 29.82, " направил"], [29.82, 29.94, " на"], [29.94, 30.1, " неё"], [30.1, 30.68, " фонарик."]]}, {"start": 30.9, "end": 33.96, "text": " Но в следующую секунду фигура исчезла.", "words": [[30.9, 31.18, " Но"], [31.18, 31.3, " в"], [31.3, 31.92, " следующую"], [31.92, 32.44, " секунду"], [32.44, 33.16, " фигура"], [33.16, 33.96, " исчезла."]]}, {"start": 34.4, "end": 37.92, "text": " Вы решили, что это просто играть и ней или гли спать.", "words": [[34.4, 34.64, " Вы"], [34.64, 35.02, " решили,"], [35.08, 35.28, " что"], [35.28, 35.58, " это"], [35.58, 35.98, " просто"], [35.98, 36.46, " играть"], [36.46, 36.56, " и"], [36.56, 36.8, " ней"], [36.8, 37.26, " или"], [37.26, 37.5, " гли"], [37.5, 37.92, " спать."]]}, {"start": 38.38, "end": 41.48, "text": " Около полуночи ты проснулся от странного звука.", "words": [[38.38, 38.7, " Около"], [38.7, 39.28, " полуночи"], [39.28, 39.6, " ты"], [39.6, 40.3, " проснулся"], [40.3, 40.5, " от"], [40.5, 41.04, " странного"], [41.04, 41.48, " звука."]]}, {"start": 41.9, "end": 44.44, "text": " Три медленных шага, потом тишина.", "words": [[41.9, 42.18, " Три"], [42.18, 42.92, " медленных"], [42.92, 43.32, " шага,"], [43.68, 43.98, " потом"], [43.98, 44.44, " тишина."]]}, {"start": 45.02, "end": 46.32, "text": " И ещё три шага.", "words": [[45.02, 45.06, " И"], [45.06, 45.52, " ещё"], [45.52, 45.86, " три"], [45.86, 46.32, " шага."]]}, {"start": 46.7, "end": 49.72, "text": " Ты осторожно открыл палатку и выглянул наружу.", "words": [[46.7, 46.86, " Ты"], [46.86, 47.52, " осторожно"], [47.52, 47.86, " открыл"], [47.86, 48.44, " палатку"], [48.44, 48.7, " и"], [48.7, 49.22, " выглянул"], [49.22, 49.72, " наружу."]]}, {"start": 50.1, "end": 52.54, "text": " На поляне стоял тот самый силуэт.", "words": [[50.1, 50.32, " На"], [50.32, 50.74, " поляне"], [50.74, 51.24, " стоял"], [51.24, 51.52, " тот"], [51.52, 51.96, " самый"], [51.96, 52.54, " силуэт."]]}, {"start": 53.0, "end": 55.42, "text": " Высокий, худой, в чёрном костюме.", "words": [[53.0, 53.62, " Высокий,"], [53.8, 54.22, " худой,"], [54.48, 54.52, " в"], [54.52, 54.9, " чёрном"], [54.9, 55.42, " костюме."]]}, {"start": 55.84, "end": 57.92, "text": " Но самое странное было в другом.", "words": [[55.84, 56.04, " Но"], [56.04, 56.34, " самое"], [56.34, 57.0, " странное"], [57.0, 57.32, " было"], [57.32, 57.46, " в"], [57.46, 57.92, " другом."]]}, {"start": 57.92, "end": 59.76, "text": " У него не было лица.", "words": [[57.92, 58.48, " У"], [58.48, 58.74, " него"], [58.74, 59.16, " не"], [59.16, 59.36, " было"], [59.36, 59.76, " лица."]]}, {"start": 60.22, "end": 61.74, "text": " Ты резко разбудил друзей.", "words": [[60.22, 60.42, " Ты"], [60.42, 60.84, " резко"], [60.84, 61.26, " разбудил"], [61.26, 61.74, " друзей."]]}, {"start": 62.06, "end": 65.64, "text": " Но когда они выбежали из палатки, фигура уже исчезла.", "words": [[62.06, 62.26, " Но"], [62.26, 62.54, " когда"], [62.54, 62.82, " они"], [62.82, 63.26, " выбежали"], [63.26, 63.42, " из"], [63.42, 63.88, " палатки,"], [64.1, 64.68, " фигура"], [64.68, 64.98, " уже"], [64.98, 65.64, " исчезла."]]}, {"start": 66.1, "end": 68.44, "text": " Утром вы решили немедленно покинуть лес.", "words": [[66.1, 66.54, " Утром"], [66.54, 66.72, " вы"], [66.72, 67.1, " решили"], [67.1, 67.76, " немедленно"], [67.76, 68.2, " покинуть"], [68.2, 68.44, " лес."]]}, {"start": 68.98, "end": 71.94, "text": " Однако дорога, по которой вы пришли, исчезла.", "words": [[68.98, 69.34, " Однако"], [69.34, 70.06, " дорога,"], [70.1, 70.2, " по"], [70.2, 70.4, " которой"], [70.4, 70.58, " вы"], [70.58, 71.04, " пришли,"], [71.3, 71.94, " исчезла."]]}, {"start": 72.36, "end": 75.5, "text": " Вместо неё повсюду были одинаковые деревья.", "words": [[72.36, 72.76, " Вместо"], [72.76, 73.08, " неё"], [73.08, 73.94, " повсюду"], [73.94, 74.16, " были"], [74.16, 75.02, " одинаковые"], [75.02, 75.5, " деревья."]]}, {"start": 75.92, "end": 80.6, "text": " Вы начали искать выход, пока не заметили странную надпись на одном из стволов.", "words": [[75.92, 76.16, " Вы"], [76.16, 76.48, " начали"], [76.48, 76.84, " искать"], [76.84, 77.2, " выход,"], [77.38, 77.56, " пока"], [77.56, 77.74, " не"], [77.74, 78.22, " заметили"], [78.22, 78.86, " странную"], [78.86, 79.38, " надпись"], [79.38, 79.64, " на"], [79.64, 79.94, " одном"], [79.94, 80.12, " из"], [80.12, 80.6, " стволов."]]}, {"start": 81.08, "end": 82.54, "text": " Не смотрите назад.", "words": [[81.08, 81.32, " Не"], [81.32, 81.84, " смотрите"], [81.84, 82.54, " назад."]]}, {"start": 83.22, "end": 85.58, "text": " В этот момент твой телефон завибрировал.", "words": [[83.22, 83.44, " В"], [83.44, 83.58, " этот"], [83.58, 83.92, " момент"], [83.92, 84.38, " твой"], [84.38, 84.78, " телефон"], [84.78, 85.58, " завибрировал."]]}, {"start": 85.58, "end": 88.66, "text": " Пришло сообщение от неизвестного отправителя.", "words": [[85.58, 86.38, " Пришло"], [86.38, 87.08, " сообщение"], [87.08, 87.36, " от"], [87.36, 88.08, " неизвестного"], [88.08, 88.66, " отправителя."]]}, {"start": 89.26, "end": 91.6, "text": " «Я вижу вас всех».", "words": [[89.26, 89.44, " «Я"], [89.44, 89.84, " вижу"], [89.84, 90.32, " вас"], [90.32, 91.6, " всех»."]]}, {"start": 91.6, "end": 94.62, "text": " Ты поднял голову и посмотрел между деревьями.", "words": [[91.6, 91.76, " Ты"], [91.76, 92.24, " поднял"], [92.24, 92.82, " голову"], [92.82, 92.96, " и"], [92.96, 93.68, " посмотрел"], [93.68, 93.9, " между"], [93.9, 94.62, " деревьями."]]}, {"start": 95.02, "end": 97.24, "text": " Там стояли три одинаковые фигуры.", "words": [[95.02, 95.16, " Там"], [95.16, 95.64, " стояли"], [95.64, 96.0, " три"], [96.0, 96.76, " одинаковые"], [96.76, 97.24, " фигуры."]]}, {"start": 97.7, "end": 100.64, "text": " Но одна из них была гораздо ближе остальных.", "words": [[97.7, 97.88, " Но"], [97.88, 98.34, " одна"], [98.34, 98.6, " из"], [98.6, 98.8, " них"], [98.8, 99.16, " была"], [99.16, 99.7, " гораздо"], [99.7, 100.16, " ближе"], [100.16, 100.64, " остальных."]]}, {"start": 101.2, "end": 102.84, "text": " И вдруг твой друг прошептал.", "words": [[101.2, 101.36, " И"], [101.36, 101.64, " вдруг"], [101.64, 101.94, " твой"], [101.94, 102.14, " друг"], [102.14, 102.84, " прошептал."]]}, {"start": 103.3, "end": 105.26, "text": " Подожди, а где четвёртый?", "words": [[103.3, 103.74, " Подожди,"], [104.3, 104.4, " а"], [104.4, 104.64, " где"], [104.64, 105.26, " четвёртый?"]]}, {"start": 105.72, "end": 108.7, "text": " Ты обернулся, но палатка уже была пуста.", "words": [[105.72, 105.92, " Ты"], [105.92, 106.64, " обернулся,"], [107.06, 107.24, " но"], [107.24, 107.8, " палатка"], [107.8, 107.96, " уже"], [107.96, 108.24, " была"], [108.24, 108.7, " пуста."]]}, {"start": 109.2, "end": 111.42, "text": " Как думаешь, куда исчез твой друг?", "words": [[109.2, 109.34, " Как"], [109.34, 109.76, " думаешь,"], [110.04, 110.34, " куда"], [110.34, 110.98, " исчез"], [110.98, 111.24, " твой"], [111.24, 111.42, " друг?"]]}]